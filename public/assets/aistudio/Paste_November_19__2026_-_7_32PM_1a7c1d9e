<script>
(function() {
  // --- DOM Elements ---
  const canvas = document.getElementById('physicsCanvas');
  const ctx = canvas.getContext('2d');

  const inputV0 = document.getElementById('inputV0');
  const sliderV0 = document.getElementById('sliderV0');
  const inputTheta = document.getElementById('inputTheta');
  const sliderTheta = document.getElementById('sliderTheta');
  const inputG = document.getElementById('inputG');
  const inputMass = document.getElementById('inputMass');
  const sliderMass = document.getElementById('sliderMass');
  const checkDrag = document.getElementById('checkDrag');
  const sliderDrag = document.getElementById('sliderDrag');
  const dragStatusLabel = document.getElementById('dragStatusLabel');
  const dragSliderContainer = document.getElementById('dragSliderContainer');
  const dragValLabel = document.getElementById('dragValLabel');

  const gPresetButtons = document.querySelectorAll('.g-preset-btn');
  const applyParamsBtn = document.getElementById('applyParamsBtn');
  const resetParamsBtn = document.getElementById('resetParamsBtn');

  const btnPlayPause = document.getElementById('btnPlayPause');
  const playIcon = document.getElementById('playIcon');
  const playLabel = document.getElementById('playLabel');
  const btnReset = document.getElementById('btnReset');
  const btnSlowMo = document.getElementById('btnSlowMo');
  const speedRateLabel = document.getElementById('speedRateLabel');
  const timeScrubber = document.getElementById('timeScrubber');

  const hudSimTime = document.getElementById('hudSimTime');
  const hudX = document.getElementById('hudX');
  const hudY = document.getElementById('hudY');
  const hudV = document.getElementById('hudV');
  const timeCurrent = document.getElementById('timeCurrent');
  const timeMax = document.getElementById('timeMax');
  const badgeVx = document.getElementById('badgeVx');
  const badgeVy = document.getElementById('badgeVy');

  const metricHmax = document.getElementById('metricHmax');
  const metricXmax = document.getElementById('metricXmax');
  const metricThmax = document.getElementById('metricThmax');
  const metricTtot = document.getElementById('metricTtot');
  const metricEk0 = document.getElementById('metricEk0');

  const simStateDot = document.getElementById('simStateDot');
  const simStateText = document.getElementById('simStateText');

  const toggleVectorsBtn = document.getElementById('toggleVectorsBtn');
  const toggleGridBtn = document.getElementById('toggleGridBtn');
  const zoomInBtn = document.getElementById('zoomInBtn');
  const zoomOutBtn = document.getElementById('zoomOutBtn');

  const tabGraphYt = document.getElementById('tabGraphYt');
  const tabGraphVt = document.getElementById('tabGraphVt');
  const tabGraphYx = document.getElementById('tabGraphYx');
  const graphTabs = [tabGraphYt, tabGraphVt, tabGraphYx];
  const svgPlotPath = document.getElementById('svgPlotPath');
  const svgPeakPoint = document.getElementById('svgPeakPoint');
  const svgCursorPoint = document.getElementById('svgCursorPoint');
  const graphAxisLabelY = document.getElementById('graphAxisLabelY');
  const graphAxisLabelX = document.getElementById('graphAxisLabelX');
  const graphEndpointLabel = document.getElementById('graphEndpointLabel');

  const btnExportCSV = document.getElementById('btnExportCSV');
  const btnCopySummary = document.getElementById('btnCopySummary');
  const toggleInfoBtn = document.getElementById('toggleInfoBtn');
  const labNotesPanel = document.getElementById('labNotesPanel');

  // --- Physics Simulation State ---
  let v0 = parseFloat(inputV0.value);
  let thetaDeg = parseFloat(inputTheta.value);
  let g = parseFloat(inputG.value);
  let mass = parseFloat(inputMass.value);
  let hasDrag = checkDrag.checked;
  let dragK = parseFloat(sliderDrag.value);

  let isPlaying = false;
  let timeScale = 1.0;
  let currentTime = 0;
  let totalFlightTime = 0;
  let hMax = 0;
  let timeAtHmax = 0;
  let xMax = 0;
  let initialKineticEnergy = 0;

  // Viewport Settings
  let showVectors = true;
  let showGrid = true;
  let zoomLevel = 1.0;
  let activeGraph = 'yt'; // 'yt', 'vt', 'yx'

  // Precomputed analytical/numerical trajectory points: {t, x, y, vx, vy, v}
  let trajectoryData = [];

  // Canvas scaling & origin
  function resizeCanvas() {
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * window.devicePixelRatio;
    canvas.height = rect.height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    drawSimulation();
  }
  window.addEventListener('resize', resizeCanvas);

  // --- Physics Analytical & Numerical Solver ---
  function computePhysics() {
    v0 = parseFloat(inputV0.value);
    thetaDeg = parseFloat(inputTheta.value);
    g = parseFloat(inputG.value);
    mass = parseFloat(inputMass.value);
    hasDrag = checkDrag.checked;
    dragK = parseFloat(sliderDrag.value);

    const thetaRad = (thetaDeg * Math.PI) / 180;
    const v0x = v0 * Math.cos(thetaRad);
    const v0y = v0 * Math.sin(thetaRad);

    initialKineticEnergy = 0.5 * mass * (v0 * v0);

    trajectoryData = [];

    if (!hasDrag) {
      // Analytical Vacuum Equations
      timeAtHmax = v0y / g;
      hMax = (v0y * v0y) / (2 * g);
      totalFlightTime = (2 * v0y) / g;
      xMax = v0x * totalFlightTime;

      // Sample ~250 points along trajectory
      const steps = 300;
      const dt = totalFlightTime / steps;
      for (let i = 0; i <= steps; i++) {
        const t = Math.min(i * dt, totalFlightTime);
        const x = v0x * t;
        const y = Math.max(0, v0y * t - 0.5 * g * t * t);
        const vx = v0x;
        const vy = v0y - g * t;
        const v = Math.sqrt(vx * vx + vy * vy);
        trajectoryData.push({ t, x, y, vx, vy, v });
      }
    } else {
      // Numerical RK4 Integration with Quadratic Drag: F_drag = -k * v * v
      let t = 0;
      let x = 0;
      let y = 0;
      let vx = v0x;
      let vy = v0y;
      const dt = 0.005;

      trajectoryData.push({ t, x, y, vx, vy, v: v0 });
      let peakFound = false;
      hMax = 0;
      timeAtHmax = 0;

      while (y >= 0 && t < 30) {
        // RK4 step
        function derivatives(curr_vx, curr_vy) {
          const spd = Math.sqrt(curr_vx * curr_vx + curr_vy * curr_vy);
          const ax = -(dragK / mass) * spd * curr_vx;
          const ay = -g - (dragK / mass) * spd * curr_vy;
          return { ax, ay };
        }

        const d1 = derivatives(vx, vy);
        const d2 = derivatives(vx + 0.5 * dt * d1.ax, vy + 0.5 * dt * d1.ay);
        const d3 = derivatives(vx + 0.5 * dt * d2.ax, vy + 0.5 * dt * d2.ay);
        const d4 = derivatives(vx + dt * d3.ax, vy + dt * d3.ay);

        const ax = (d1.ax + 2 * d2.ax + 2 * d3.ax + d4.ax) / 6;
        const ay = (d1.ay + 2 * d2.ay + 2 * d3.ay + d4.ay) / 6;

        x += vx * dt;
        y += vy * dt;
        vx += ax * dt;
        vy += ay * dt;
        t += dt;

        if (y > hMax) {
          hMax = y;
          timeAtHmax = t;
        }

        const v = Math.sqrt(vx * vx + vy * vy);
        if (y >= 0) {
          trajectoryData.push({ t, x, y, vx, vy, v });
        }
      }

      totalFlightTime = trajectoryData[trajectoryData.length - 1].t;
      xMax = trajectoryData[trajectoryData.length - 1].x;
    }

    // Update readouts
    metricHmax.textContent = hMax.toFixed(2) + ' m';
    metricXmax.textContent = xMax.toFixed(2) + ' m';
    metricThmax.textContent = timeAtHmax.toFixed(2) + ' s';
    metricTtot.textContent = totalFlightTime.toFixed(2) + ' s';
    metricEk0.textContent = initialKineticEnergy.toFixed(1) + ' J';

    timeMax.textContent = totalFlightTime.toFixed(2) + 's';
    timeScrubber.max = totalFlightTime.toString();

    if (currentTime > totalFlightTime) {
      currentTime = totalFlightTime;
    }

    updateScientificSvgPlot();
    drawSimulation();
  }

  // Interpolate state at arbitrary t
  function getStateAtTime(targetT) {
    if (trajectoryData.length === 0) return { x: 0, y: 0, vx: 0, vy: 0, v: 0 };
    if (targetT <= 0) return trajectoryData[0];
    if (targetT >= totalFlightTime) return trajectoryData[trajectoryData.length - 1];

    // Binary search or linear scan
    for (let i = 0; i < trajectoryData.length - 1; i++) {
      if (trajectoryData[i + 1].t >= targetT) {
        const p1 = trajectoryData[i];
        const p2 = trajectoryData[i + 1];
        const ratio = (targetT - p1.t) / (p2.t - p1.t);
        return {
          x: p1.x + (p2.x - p1.x) * ratio,
          y: p1.y + (p2.y - p1.y) * ratio,
          vx: p1.vx + (p2.vx - p1.vx) * ratio,
          vy: p1.vy + (p2.vy - p1.vy) * ratio,
          v: p1.v + (p2.v - p1.v) * ratio
        };
      }
    }
    return trajectoryData[trajectoryData.length - 1];
  }

  // --- Rendering Canvas ---
  function drawSimulation() {
    const rect = canvas.getBoundingClientRect();
    const w = rect.width;
    const h = rect.height;

    ctx.clearRect(0, 0, w, h);

    // Dynamic scale to fit trajectory in viewport
    const paddingLeft = 50;
    const paddingBottom = 45;
    const paddingTop = 50;
    const paddingRight = 40;

    const availableW = w - paddingLeft - paddingRight;
    const availableH = h - paddingTop - paddingBottom;

    const maxSimX = Math.max(xMax * 1.15, 20);
    const maxSimY = Math.max(hMax * 1.35, 10);

    const scaleX = (availableW / maxSimX) * zoomLevel;
    const scaleY = (availableH / maxSimY) * zoomLevel;
    // Keep aspect ratio uniform
    const scale = Math.min(scaleX, scaleY);

    const originX = paddingLeft;
    const originY = h - paddingBottom;

    function toScreenX(xVal) { return originX + xVal * scale; }
    function toScreenY(yVal) { return originY - yVal * scale; }

    // 1. Draw Grid Lines
    if (showGrid) {
      ctx.save();
      ctx.strokeStyle = '#c1c8c6';
      ctx.lineWidth = 0.5;
      ctx.setLineDash([2, 4]);

      // Choose grid interval based on scale (e.g. 5m, 10m, 20m)
      const stepMeters = maxSimX > 100 ? 20 : (maxSimX > 40 ? 10 : 5);

      // Vertical grid lines
      ctx.fillStyle = '#727877';
      ctx.font = '10px "JetBrains Mono"';
      for (let xm = stepMeters; xm <= maxSimX * 1.5; xm += stepMeters) {
        const sx = toScreenX(xm);
        if (sx > w - 10) break;
        ctx.beginPath();
        ctx.moveTo(sx, paddingTop - 10);
        ctx.lineTo(sx, originY);
        ctx.stroke();
        ctx.fillText(xm + 'm', sx - 8, originY + 16);
      }

      // Horizontal grid lines
      for (let ym = stepMeters; ym <= maxSimY * 1.5; ym += stepMeters) {
        const sy = toScreenY(ym);
        if (sy < 15) break;
        ctx.beginPath();
        ctx.moveTo(originX, sy);
        ctx.lineTo(w - paddingRight, sy);
        ctx.stroke();
        ctx.fillText(ym + 'm', originX - 32, sy + 3);
      }
      ctx.restore();
    }

    // 2. Ground & Axis Lines
    ctx.save();
    // Ground plane
    ctx.fillStyle = '#d0e7e2';
    ctx.fillRect(0, originY, w, h - originY);

    // Primary Axis lines
    ctx.strokeStyle = '#06201d';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    // Y-Axis
    ctx.moveTo(originX, originY);
    ctx.lineTo(originX, 20);
    // X-Axis
    ctx.moveTo(originX, originY);
    ctx.lineTo(w - 20, originY);
    ctx.stroke();

    // Ground grass line micro-texture
    ctx.strokeStyle = '#7ba09a';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, originY);
    ctx.lineTo(w, originY);
    ctx.stroke();
    ctx.restore();

    // 3. Trajectory Path (Full Analytical Curve)
    if (trajectoryData.length > 1) {
      ctx.save();
      ctx.strokeStyle = '#1d3532';
      ctx.lineWidth = 2.5;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.moveTo(toScreenX(trajectoryData[0].x), toScreenY(trajectoryData[0].y));
      for (let i = 1; i < trajectoryData.length; i++) {
        ctx.lineTo(toScreenX(trajectoryData[i].x), toScreenY(trajectoryData[i].y));
      }
      ctx.stroke();
      ctx.restore();
    }

    // 4. Milestone Markers (H_max & X_max)
    const peakX = trajectoryData.find(pt => Math.abs(pt.t - timeAtHmax) < 0.05) || { x: xMax / 2 };
    const screenPeakX = toScreenX(peakX.x || (xMax / 2));
    const screenPeakY = toScreenY(hMax);

    // Peak Marker
    ctx.save();
    ctx.fillStyle = '#fd8276';
    ctx.beginPath();
    ctx.arc(screenPeakX, screenPeakY, 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#a23d35';
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.font = '10px "JetBrains Mono"';
    ctx.fillStyle = '#06201d';
    ctx.fillText(`H_max=${hMax.toFixed(1)}m`, screenPeakX - 35, screenPeakY - 10);
    ctx.restore();

    // Landing marker
    const screenLandX = toScreenX(xMax);
    ctx.save();
    ctx.fillStyle = '#06201d';
    ctx.beginPath();
    ctx.arc(screenLandX, originY, 3.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillText(`X_max=${xMax.toFixed(1)}m`, screenLandX - 25, originY - 8);
    ctx.restore();

    // 5. Cannon Launcher Base
    const thetaRad = (thetaDeg * Math.PI) / 180;
    const barrelLen = 22;
    ctx.save();
    // Wheel / Mount
    ctx.fillStyle = '#1d3532';
    ctx.beginPath();
    ctx.arc(originX, originY, 7, 0, Math.PI * 2);
    ctx.fill();
    // Cannon Barrel
    ctx.strokeStyle = '#06201d';
    ctx.lineWidth = 5;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(originX, originY);
    ctx.lineTo(originX + barrelLen * Math.cos(thetaRad), originY - barrelLen * Math.sin(thetaRad));
    ctx.stroke();
    ctx.restore();

    // 6. Current Flight State / Projectile Particle
    const curr = getStateAtTime(currentTime);
    const currScreenX = toScreenX(curr.x);
    const currScreenY = toScreenY(curr.y);

    // Particle flight trail
    ctx.save();
    ctx.strokeStyle = '#a23d35';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(toScreenX(trajectoryData[0].x), toScreenY(trajectoryData[0].y));
    for (let i = 0; i < trajectoryData.length; i++) {
      if (trajectoryData[i].t <= currentTime) {
        ctx.lineTo(toScreenX(trajectoryData[i].x), toScreenY(trajectoryData[i].y));
      } else {
        ctx.lineTo(currScreenX, currScreenY);
        break;
      }
    }
    ctx.stroke();
    ctx.restore();

    // Ball Object
    ctx.save();
    ctx.fillStyle = '#a23d35';
    ctx.shadowColor = 'rgba(162, 61, 53, 0.4)';
    ctx.shadowBlur = 8;
    ctx.beginPath();
    ctx.arc(currScreenX, currScreenY, 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    // Velocity Vector Arrows (if enabled)
    if (showVectors && curr.v > 0.05) {
      ctx.save();
      const vectorScale = 1.3; // screen px per m/s

      // vx vector (horizontal - teal)
      ctx.strokeStyle = '#4b635f';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(currScreenX, currScreenY);
      ctx.lineTo(currScreenX + curr.vx * vectorScale, currScreenY);
      ctx.stroke();

      // vy vector (vertical - teal)
      ctx.beginPath();
      ctx.moveTo(currScreenX, currScreenY);
      ctx.lineTo(currScreenX, currScreenY - curr.vy * vectorScale);
      ctx.stroke();

      // Resultant vector v_total (coral secondary)
      ctx.strokeStyle = '#a23d35';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(currScreenX, currScreenY);
      const targetVx = currScreenX + curr.vx * vectorScale;
      const targetVy = currScreenY - curr.vy * vectorScale;
      ctx.lineTo(targetVx, targetVy);
      ctx.stroke();

      // Tiny Arrowhead for Resultant Vector
      const angle = Math.atan2(-(currScreenY - targetVy), targetVx - currScreenX);
      const arrowSize = 6;
      ctx.fillStyle = '#a23d35';
      ctx.beginPath();
      ctx.moveTo(targetVx, targetVy);
      ctx.lineTo(targetVx - arrowSize * Math.cos(angle - Math.PI / 6), targetVy - arrowSize * Math.sin(angle - Math.PI / 6));
      ctx.lineTo(targetVx - arrowSize * Math.cos(angle + Math.PI / 6), targetVy - arrowSize * Math.sin(angle + Math.PI / 6));
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    // Update Floating HUD and Bottom Indicators
    hudSimTime.textContent = `t = ${currentTime.toFixed(2)} s`;
    hudX.textContent = `${curr.x.toFixed(2)} m`;
    hudY.textContent = `${curr.y.toFixed(2)} m`;
    hudV.textContent = `${curr.v.toFixed(1)} m/s`;
    timeCurrent.textContent = `${currentTime.toFixed(2)}s`;
    timeScrubber.value = currentTime;
    badgeVx.textContent = `${curr.vx.toFixed(2)} m/s`;
    badgeVy.textContent = `${curr.vy.toFixed(2)} m/s`;

    // Update cursor marker on scientific plot
    updatePlotCursor();
  }

  // --- Real-Time Scientific SVG Plot Generator ---
  function updateScientificSvgPlot() {
    if (trajectoryData.length === 0) return;

    let points = [];
    const svgW = 240;
    const svgH = 80;
    const offsetX = 25;
    const offsetY = 15;

    if (activeGraph === 'yt') {
      graphAxisLabelY.textContent = 'Posisi Vertikal y (m)';
      graphAxisLabelX.textContent = 'Waktu t (s)';
      graphEndpointLabel.textContent = `t_tot = ${totalFlightTime.toFixed(2)}s, H_max = ${hMax.toFixed(2)}m`;

      points = trajectoryData.map(pt => {
        const nx = (pt.t / totalFlightTime) * svgW;
        const ny = svgH - (pt.y / (hMax * 1.15 || 1)) * svgH;
        return { x: offsetX + nx, y: offsetY + ny };
      });

      // Peak Indicator
      const peakX = (timeAtHmax / totalFlightTime) * svgW + offsetX;
      const peakY = offsetY + svgH - (hMax / (hMax * 1.15 || 1)) * svgH;
      svgPeakPoint.setAttribute('cx', peakX);
      svgPeakPoint.setAttribute('cy', peakY);
      svgPeakPoint.setAttribute('opacity', '1');

    } else if (activeGraph === 'vt') {
      graphAxisLabelY.textContent = 'Kecepatan Total v (m/s)';
      graphAxisLabelX.textContent = 'Waktu t (s)';
      const maxV = Math.max(...trajectoryData.map(d => d.v));
      const minV = Math.min(...trajectoryData.map(d => d.v));
      graphEndpointLabel.textContent = `v_min = ${minV.toFixed(1)} m/s, v_0 = ${v0.toFixed(1)} m/s`;

      points = trajectoryData.map(pt => {
        const nx = (pt.t / totalFlightTime) * svgW;
        const ny = svgH - ((pt.v - minV * 0.9) / (maxV - minV * 0.9 || 1)) * svgH;
        return { x: offsetX + nx, y: offsetY + ny };
      });
      svgPeakPoint.setAttribute('opacity', '0');

    } else if (activeGraph === 'yx') {
      graphAxisLabelY.textContent = 'Ketinggian y (m)';
      graphAxisLabelX.textContent = 'Jarak Horizontal x (m)';
      graphEndpointLabel.textContent = `X_max = ${xMax.toFixed(2)}m, H_max = ${hMax.toFixed(2)}m`;

      points = trajectoryData.map(pt => {
        const nx = (pt.x / xMax) * svgW;
        const ny = svgH - (pt.y / (hMax * 1.15 || 1)) * svgH;
        return { x: offsetX + nx, y: offsetY + ny };
      });

      const peakX = ((xMax / 2) / xMax) * svgW + offsetX;
      const peakY = offsetY + svgH - (hMax / (hMax * 1.15 || 1)) * svgH;
      svgPeakPoint.setAttribute('cx', peakX);
      svgPeakPoint.setAttribute('cy', peakY);
      svgPeakPoint.setAttribute('opacity', '1');
    }

    // Build SVG Path d string
    if (points.length > 0) {
      let dStr = `M ${points[0].x.toFixed(1)},${points[0].y.toFixed(1)}`;
      for (let i = 1; i < points.length; i += 2) {
        dStr += ` L ${points[i].x.toFixed(1)},${points[i].y.toFixed(1)}`;
      }
      svgPlotPath.setAttribute('d', dStr);
    }
  }

  function updatePlotCursor() {
    if (trajectoryData.length === 0) return;
    const curr = getStateAtTime(currentTime);
    const svgW = 240;
    const svgH = 80;
    const offsetX = 25;
    const offsetY = 15;

    let cx = offsetX;
    let cy = offsetY + svgH;

    if (activeGraph === 'yt') {
      cx = offsetX + (currentTime / (totalFlightTime || 1)) * svgW;
      cy = offsetY + svgH - (curr.y / (hMax * 1.15 || 1)) * svgH;
    } else if (activeGraph === 'vt') {
      const maxV = Math.max(...trajectoryData.map(d => d.v));
      const minV = Math.min(...trajectoryData.map(d => d.v));
      cx = offsetX + (currentTime / (totalFlightTime || 1)) * svgW;
      cy = offsetY + svgH - ((curr.v - minV * 0.9) / (maxV - minV * 0.9 || 1)) * svgH;
    } else if (activeGraph === 'yx') {
      cx = offsetX + (curr.x / (xMax || 1)) * svgW;
      cy = offsetY + svgH - (curr.y / (hMax * 1.15 || 1)) * svgH;
    }

    svgCursorPoint.setAttribute('cx', isNaN(cx) ? offsetX : cx);
    svgCursorPoint.setAttribute('cy', isNaN(cy) ? offsetY + svgH : cy);
  }

  // --- Animation Loop ---
  let lastTimestamp = 0;
  function animationStep(timestamp) {
    if (!lastTimestamp) lastTimestamp = timestamp;
    const deltaSec = (timestamp - lastTimestamp) / 1000;
    lastTimestamp = timestamp;

    if (isPlaying) {
      currentTime += deltaSec * timeScale;
      if (currentTime >= totalFlightTime) {
        currentTime = totalFlightTime;
        pauseSimulation();
        simStateText.textContent = "LINTASAN SELESAI";
        simStateDot.className = "inline-block w-2.5 h-2.5 rounded-full bg-primary";
      }
      drawSimulation();
    }

    requestAnimationFrame(animationStep);
  }
  requestAnimationFrame(animationStep);

  function startSimulation() {
    if (currentTime >= totalFlightTime) {
      currentTime = 0;
    }
    isPlaying = true;
    playIcon.textContent = 'pause';
    playLabel.textContent = 'Jeda Simulasi';
    simStateText.textContent = 'SIMULASI AKTIF';
    simStateDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-secondary animate-pulse';
  }

  function pauseSimulation() {
    isPlaying = false;
    playIcon.textContent = 'play_arrow';
    playLabel.textContent = 'Lanjutkan';
    simStateText.textContent = 'TERJEDA';
    simStateDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-outline';
  }

  btnPlayPause.addEventListener('click', () => {
    if (isPlaying) {
      pauseSimulation();
    } else {
      startSimulation();
    }
  });

  btnReset.addEventListener('click', () => {
    pauseSimulation();
    currentTime = 0;
    simStateText.textContent = 'SIAP MELUNCUR';
    simStateDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-secondary';
    drawSimulation();
  });

  btnSlowMo.addEventListener('click', () => {
    if (timeScale === 1.0) {
      timeScale = 0.5;
      speedRateLabel.textContent = '0.5x';
    } else if (timeScale === 0.5) {
      timeScale = 0.25;
      speedRateLabel.textContent = '0.25x';
    } else {
      timeScale = 1.0;
      speedRateLabel.textContent = '1.0x';
    }
  });

  timeScrubber.addEventListener('input', (e) => {
    currentTime = parseFloat(e.target.value);
    drawSimulation();
  });

  // --- Parameter Synching (Slider <-> Number inputs) ---
  function syncPair(inputEl, sliderEl) {
    inputEl.addEventListener('input', () => {
      sliderEl.value = inputEl.value;
      computePhysics();
    });
    sliderEl.addEventListener('input', () => {
      inputEl.value = sliderEl.value;
      computePhysics();
    });
  }

  syncPair(inputV0, sliderV0);
  syncPair(inputTheta, sliderTheta);
  syncPair(inputMass, sliderMass);

  inputG.addEventListener('input', () => {
    computePhysics();
    gPresetButtons.forEach(btn => btn.classList.remove('bg-secondary', 'text-on-secondary'));
  });

  gPresetButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      gPresetButtons.forEach(b => {
        b.classList.remove('bg-secondary', 'text-on-secondary');
        b.classList.add('bg-surface-container-high', 'text-primary');
      });
      btn.classList.add('bg-secondary', 'text-on-secondary');
      btn.classList.remove('bg-surface-container-high', 'text-primary');
      inputG.value = btn.dataset.g;
      computePhysics();
    });
  });

  checkDrag.addEventListener('change', () => {
    if (checkDrag.checked) {
      dragSliderContainer.classList.remove('opacity-50', 'pointer-events-none');
      dragStatusLabel.textContent = 'Hambatan Aktif (k=' + sliderDrag.value + ')';
    } else {
      dragSliderContainer.classList.add('opacity-50', 'pointer-events-none');
      dragStatusLabel.textContent = 'Non-Aktif (Vakum)';
    }
    computePhysics();
  });

  sliderDrag.addEventListener('input', () => {
    dragValLabel.textContent = `${sliderDrag.value} kg/m`;
    if (checkDrag.checked) {
      dragStatusLabel.textContent = 'Hambatan Aktif (k=' + sliderDrag.value + ')';
    }
    computePhysics();
  });

  applyParamsBtn.addEventListener('click', () => {
    computePhysics();
    currentTime = 0;
    startSimulation();
  });

  resetParamsBtn.addEventListener('click', () => {
    inputV0.value = 28.0; sliderV0.value = 28.0;
    inputTheta.value = 45; sliderTheta.value = 45;
    inputG.value = 9.80;
    inputMass.value = 1.20; sliderMass.value = 1.20;
    checkDrag.checked = false;
    dragSliderContainer.classList.add('opacity-50', 'pointer-events-none');
    dragStatusLabel.textContent = 'Non-Aktif (Vakum)';
    gPresetButtons.forEach(b => {
      if (b.dataset.g === '9.80') {
        b.classList.add('bg-secondary', 'text-on-secondary');
      } else {
        b.classList.remove('bg-secondary', 'text-on-secondary');
        b.classList.add('bg-surface-container-high', 'text-primary');
      }
    });
    computePhysics();
    currentTime = 0;
    pauseSimulation();
    drawSimulation();
  });

  // --- Viewport Toggles ---
  toggleVectorsBtn.addEventListener('click', () => {
    showVectors = !showVectors;
    toggleVectorsBtn.classList.toggle('bg-secondary');
    toggleVectorsBtn.classList.toggle('text-on-secondary');
    drawSimulation();
  });

  toggleGridBtn.addEventListener('click', () => {
    showGrid = !showGrid;
    toggleGridBtn.classList.toggle('opacity-50');
    drawSimulation();
  });

  zoomInBtn.addEventListener('click', () => {
    zoomLevel = Math.min(zoomLevel + 0.15, 2.0);
    drawSimulation();
  });

  zoomOutBtn.addEventListener('click', () => {
    zoomLevel = Math.max(zoomLevel - 0.15, 0.6);
    drawSimulation();
  });

  // --- Graph Switcher Tabs ---
  function setGraphTab(activeBtn, type) {
    graphTabs.forEach(tab => {
      tab.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-xs');
      tab.classList.add('text-on-surface-variant');
    });
    activeBtn.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-xs');
    activeBtn.classList.remove('text-on-surface-variant');
    activeGraph = type;
    updateScientificSvgPlot();
    updatePlotCursor();
  }

  tabGraphYt.addEventListener('click', () => setGraphTab(tabGraphYt, 'yt'));
  tabGraphVt.addEventListener('click', () => setGraphTab(tabGraphVt, 'vt'));
  tabGraphYx.addEventListener('click', () => setGraphTab(tabGraphYx, 'yx'));

  // --- Export and Copy Functions ---
  btnExportCSV.addEventListener('click', () => {
    let csv = 'Waktu(s),Posisi_X(m),Posisi_Y(m),Kecepatan_Vx(m/s),Kecepatan_Vy(m/s),Kecepatan_Total(m/s)\n';
    trajectoryData.forEach(row => {
      csv += `${row.t.toFixed(3)},${row.x.toFixed(3)},${row.y.toFixed(3)},${row.vx.toFixed(3)},${row.vy.toFixed(3)},${row.v.toFixed(3)}\n`;
    });
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `physilab_gerak_parabola_v0_${v0}_deg_${thetaDeg}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  btnCopySummary.addEventListener('click', () => {
    const summary = `PHYSILAB HASIL SIMULASI:\nModel: Kinematika Gerak Parabola\nKecepatan Awal (v0): ${v0} m/s\nSudut Elevasi (θ): ${thetaDeg}°\nGravitasi (g): ${g} m/s²\nMassa (m): ${mass} kg\nHambatan Udara: ${hasDrag ? 'Aktif (k=' + dragK + ')' : 'Vakum'}\n---\nKetinggian Maksimum (H_max): ${hMax.toFixed(2)} m\nJangkauan Terjauh (X_max): ${xMax.toFixed(2)} m\nWaktu Puncak: ${timeAtHmax.toFixed(2)} s\nTotal Waktu Terbang: ${totalFlightTime.toFixed(2)} s\nEnergi Kinetik Awal: ${initialKineticEnergy.toFixed(1)} J`;
    navigator.clipboard.writeText(summary).then(() => {
      const originalText = btnCopySummary.innerHTML;
      btnCopySummary.innerHTML = '<span class="material-symbols-outlined text-[16px]">done</span><span>Tersalin!</span>';
      setTimeout(() => {
        btnCopySummary.innerHTML = originalText;
      }, 2000);
    });
  });

  toggleInfoBtn.addEventListener('click', () => {
    labNotesPanel.scrollIntoView({ behavior: 'smooth' });
    labNotesPanel.classList.add('ring-2', 'ring-secondary');
    setTimeout(() => labNotesPanel.classList.remove('ring-2', 'ring-secondary'), 1500);
  });

  // Initial Boot
  resizeCanvas();
  computePhysics();
})();
</script></main><footer class="w-full bg-surface-container-low mt-auto"><div class="w-full px-gutter-lg py-space-lg flex flex-col md:flex-row items-center justify-between gap-space-md"><div class="flex items-center gap-space-md"><div class="flex items-center gap-space-xs"><span class="inline-block w-2 h-2 rounded-full bg-secondary"></span><span class="font-code-sm text-code-sm text-primary tracking-wider uppercase font-semibold">PhysiEngine Core v2.4</span></div><span class="text-outline font-code-sm text-code-sm">|</span><span class="font-body-sm text-body-sm text-on-surface-variant">Open Physics Compute Engine &amp; Scientific Symbolic Library</span></div><div class="flex items-center gap-space-lg"><span class="font-code-sm text-code-sm text-on-surface-variant">ISO/IEC 80000-1 Quantities &amp; Units Compliant</span><span class="font-body-sm text-body-sm text-on-surface-variant">© 2025 PHYSILAB. CC-BY 4.0 International Science Research License.</span></div></div></footer></body></html>


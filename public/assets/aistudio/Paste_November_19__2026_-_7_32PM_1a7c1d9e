      uploadPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      manualBtn.className = "flex items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-surface-container-lowest text-primary font-label-md text-label-md shadow-sm transition-all";
      uploadBtn.className = "flex items-center gap-space-xs px-space-md py-space-sm rounded-lg text-on-surface-variant hover:text-primary font-label-md text-label-md transition-all";
      manualPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function insertSymbol(sym) {
    const input = document.getElementById('latex-input');
    if (!input) return;
    const start = input.selectionStart || input.value.length;
    const end = input.selectionEnd || input.value.length;
    input.value = input.value.substring(0, start) + sym + input.value.substring(end);
    input.focus();
    input.setSelectionRange(start + sym.length, start + sym.length);
  }

  function recomputePhysics() {
    const m = parseFloat(document.getElementById('input-m').value) || 0;
    const v = parseFloat(document.getElementById('input-v').value) || 0;
    const g = parseFloat(document.getElementById('input-g').value) || 9.80665;
    const h = parseFloat(document.getElementById('input-h').value) || 0;

    const ek = 0.5 * m * (v * v);
    const ep = m * g * h;
    const em = ek + ep;

    const formattedEm = em.toFixed(1) + " J";
    const formattedEk = ek.toFixed(1) + " J";
    const formattedEp = ep.toFixed(1) + " J";

    document.getElementById('disp-total-em').innerText = formattedEm;
    document.getElementById('disp-ek').innerText = formattedEk;
    document.getElementById('disp-ep').innerText = formattedEp;
    document.getElementById('table-output-em').innerText = em.toFixed(2) + " J";
    document.getElementById('disp-equation-summary').innerText = 
      `E_m = ${formattedEk} + ${formattedEp} = ${em.toFixed(1)} Joule`;

    // Dynamic marker update in SVG preview (clamped between h: 0 to 20m)
    const normalizedH = Math.min(Math.max(h / 20.0, 0), 1);
    const markerX = 30 + normalizedH * 320;
    
    // Y values: baseline is 105 (0 J), top is 20 (Max J)
    const markerEpY = 105 - (normalizedH * 85);
    const markerEkY = 20 + (normalizedH * 85);

    const markerEp = document.getElementById('graph-marker-ep');
    const markerEk = document.getElementById('graph-marker-ek');
    if (markerEp && markerEk) {
      markerEp.setAttribute('cx', markerX);
      markerEp.setAttribute('cy', markerEpY);
      markerEk.setAttribute('cx', markerX);
      markerEk.setAttribute('cy', markerEkY);
    }
  }

  function resetWorkspace() {
    document.getElementById('input-m').value = "2.0";
    document.getElementById('input-v').value = "10.0";
    document.getElementById('input-h').value = "15.0";
    document.getElementById('latex-input').value = "E_m = E_k + E_p = \\frac{1}{2}mv^2 + mgh";
    recomputePhysics();
  }

  function loadTemplate(type) {
    if (type === 'pendulum') {
      document.getElementById('latex-input').value = "T = 2\\pi \\sqrt{\\frac{L}{g}}";
    } else if (type === 'spring') {
      document.getElementById('latex-input').value = "F = -k \\cdot x, \\quad E_p = \\frac{1}{2}kx^2";
    } else if (type === 'projectile') {
      document.getElementById('latex-input').value = "y(t) = v_0 \\sin(\\theta)t - \\frac{1}{2}gt^2";
    }
    recomputePhysics();
  }

  function launchSimulationCanvas() {
    const launchBtn = event.currentTarget;
    launchBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">sync</span> Menginisialisasi Kanvas...';
    setTimeout(() => {
      window.location.hash = "simulasi";
    }, 450);
  }

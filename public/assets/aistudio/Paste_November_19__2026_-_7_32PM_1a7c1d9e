<script>
    (function initPhysicsHarmonicEngine() {
      const canvas = document.getElementById('oscillator-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      const massInput = document.getElementById('mass-slider');
      const dampInput = document.getElementById('damping-slider');
      const massVal = document.getElementById('mass-value');
      const dampVal = document.getElementById('damping-value');
      const resetBtn = document.getElementById('oscillate-reset-btn');
      const readout = document.getElementById('canvas-readout');

      let mass = parseFloat(massInput.value);
      let damping = parseFloat(dampInput.value);
      const k = 20.0; // Spring constant
      let time = 0;
      let historyPoints = [];

      function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * window.devicePixelRatio;
        canvas.height = rect.height * window.devicePixelRatio;
        ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      massInput.addEventListener('input', (e) => {
        mass = parseFloat(e.target.value);
        massVal.textContent = mass.toFixed(1) + ' kg';
        updateReadout();
      });

      dampInput.addEventListener('input', (e) => {
        damping = parseFloat(e.target.value);
        dampVal.textContent = damping.toFixed(2) + ' Ns/m';
        updateReadout();
      });

      resetBtn.addEventListener('click', () => {
        mass = 2.5;
        damping = 0.1;
        massInput.value = mass;
        dampInput.value = damping;
        massVal.textContent = '2.5 kg';
        dampVal.textContent = '0.10 Ns/m';
        time = 0;
        historyPoints = [];
        updateReadout();
      });

      function updateReadout() {
        const omega = Math.sqrt(Math.max(0.1, k / mass));
        readout.textContent = 'ω = ' + omega.toFixed(2) + ' rad/s | γ = ' + (damping / (2 * mass)).toFixed(2);
      }
      updateReadout();

      function render() {
        const rect = canvas.getBoundingClientRect();
        const width = rect.width;
        const height = rect.height;
        const centerY = height / 2;

        ctx.clearRect(0, 0, width, height);

        // Center line
        ctx.strokeStyle = '#c1c8c6';
        ctx.setLineDash([4, 4]);
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, centerY);
        ctx.lineTo(width, centerY);
        ctx.stroke();
        ctx.setLineDash([]);

        // Calculate current y position
        time += 0.035;
        const gamma = damping / (2 * mass);
        const omega = Math.sqrt(Math.max(0.01, (k / mass) - (gamma * gamma)));
        const amplitude = (height * 0.35) * Math.exp(-gamma * (time % 8));
        const currentY = centerY - amplitude * Math.cos(omega * (time % 8));

        // Add history point
        historyPoints.push(currentY);
        if (historyPoints.length > 180) {
          historyPoints.shift();
        }

        // Draw wave trajectory line
        ctx.strokeStyle = '#a23d35';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        for (let i = 0; i < historyPoints.length; i++) {
          const x = width - (historyPoints.length - i) * (width / 180);
          const y = historyPoints[i];
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();

        // Draw oscillating bob (Pixel styled square probe)
        const currentX = width - 12;
        ctx.fillStyle = '#06201d';
        ctx.fillRect(currentX - 5, currentY - 5, 10, 10);

        // Pixel-accent crosshair center
        ctx.fillStyle = '#ffdad6';
        ctx.fillRect(currentX - 1, currentY - 1, 2, 2);

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);
    })();
  </script>

<script>
  // Simple interactive micro-controls for graphing interface
  document.addEventListener('DOMContentLoaded', () => {
    const vectorBtn = document.getElementById('toggle-vectors');
    const dragBtn = document.getElementById('toggle-drag');
    const vectorGroup = document.getElementById('vector-group');
    const dragPath = document.getElementById('drag-path');
    const exportCsvBtn = document.getElementById('btn-export-csv');
    const exportPlotBtn = document.getElementById('btn-export-plot');
    const toast = document.getElementById('toast-export');
    const toastMessage = document.getElementById('toast-message');

    let showVectors = true;
    let showDrag = true;

    // Toggle Vector HUD on Plot 1
    if (vectorBtn && vectorGroup) {
      vectorBtn.addEventListener('click', () => {
        showVectors = !showVectors;
        vectorGroup.style.opacity = showVectors ? '1' : '0';
        vectorBtn.classList.toggle('bg-surface-container-high', !showVectors);
      });
    }

    // Toggle Drag Curve
    if (dragBtn && dragPath) {
      dragBtn.addEventListener('click', () => {
        showDrag = !showDrag;
        dragPath.style.opacity = showDrag ? '0.8' : '0';
        dragBtn.classList.toggle('bg-surface-container-high', showDrag);
      });
    }

    // Micro-toast trigger for export actions
    function triggerToast(message) {
      if (!toast || !toastMessage) return;
      toastMessage.textContent = message;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.remove('opacity-0', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
      }, 10);

      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3500);
    }

    if (exportCsvBtn) {
      exportCsvBtn.addEventListener('click', () => {
        triggerToast('Berkas CSV [404 titik integrasi] berhasil diproses');
      });
    }

    if (exportPlotBtn) {
      exportPlotBtn.addEventListener('click', () => {
        triggerToast('Gambar Vektor Grafik (SVG 300 DPI) diekspor ke unduhan');
      });
